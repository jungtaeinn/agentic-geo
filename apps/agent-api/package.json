{
  "name": "@agentic-geo/agent-api",
  "private": true,
  "version": "0.2.0",
  "description": "Async GEO generation API service called by dispatcher; persists results to shared Aurora.",
  "scripts": {
    "build": "nest build --webpack",
    "dev": "nest start --webpack --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:int": "jest -c jest.int.config.cjs --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:regression": "jest -c test/regression/jest.regression.config.cjs --runInBand"
  },
  "dependencies": {
    "@langfuse/otel": "^5.10.0",
    "@langfuse/tracing": "^5.10.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/typeorm": "^11.0.3",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@agentic-geo/pdp-extractor-agent": "workspace:*",
    "@agentic-geo/pdp-geo-generator-agent": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@agentic-geo/pdp-geo-eval-agent": "workspace:*",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "25.9.3",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "eslint": "9.39.4",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.2",
    "webpack-node-externals": "^3.0.0",
    "yaml": "^2.9.0"
  },
