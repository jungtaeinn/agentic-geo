PORT=3000
AGENT_API_KEY=
# 로그 임계값 (trace|debug|info|warn|error|fatal, 기본 info). 로그는 항상 JSON 한 줄로 나온다.
LOG_LEVEL=info
GEO_WORKER_CONCURRENCY=4
GEO_QUEUE_MAX_WAITING=100

# 로컬 개발 DB 예시 — 실제 배포 값은 비공개 환경 변수로 주입
DB_HOST=localhost
DB_PORT=5543
DB_NAME=agentic_geo
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=agentic_geo
# 관리형 DB에서 SSL이 필수이면 true. 로컬 PostgreSQL은 기본 false.
DB_SSL=
# SSL 사용 시 서버 cert 검증(기본 true). RDS cert가 로컬에서 안 잡히면 false.
DB_SSL_REJECT_UNAUTHORIZED=

# GEO provider (형제 앱과 동일 규칙; 기본 mock)
AGENTIC_GEO_PROVIDER=mock
# 상품 신호 정규화 LLM 호출 (non-mock + API 키면 기본 활성; false로만 비활성)
AGENTIC_GEO_PRODUCT_NORMALIZATION=
OPENAI_API_KEY=
OPENAI_MODEL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_REASONING_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_OCR_DEPLOYMENT=gpt-5.5
# OCR 대상 이미지 호스트 허용목록(선택, 콤마 구분 호스트 접미). 미설정 시 http(s)·사설/링크로컬 차단만
# 적용되고 그 외 호스트는 통과. 설정했는데 빈 값(콤마·공백만)이면 fail-closed로 전량 거부된다.
# AGENTIC_GEO_OCR_IMAGE_ALLOWED_HOSTS=cdn.example.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# 임베딩이 별도 Azure 리소스면 지정(미지정 시 reasoning 엔드포인트/키 공유)
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_VERSION=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_PROOFREADING_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_TEMPERATURE=
# AI Studio (사용자 지정 게이트웨이, Azure 스타일 chat completions 프록시 — 모델 id가 곧 deployment id)
AISTUDIO_API_KEY=
AISTUDIO_ENDPOINT=
AISTUDIO_MODEL=gpt-5.5
AISTUDIO_API_VERSION=

# Langfuse 로컬 트레이싱 (로컬 전용 — 배포 환경에는 주입하지 않는다. README "로컬 관측 — Langfuse" 참고)
# 값은 docker-compose.langfuse.yml의 LANGFUSE_INIT_* 키와 일치해야 한다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3100
# true일 때만 동기 테스트 엔드포인트(POST /internal/v1/geo/test-generations) 활성화
GEO_TEST_SYNC_ENDPOINT=true

# docker-compose.langfuse.yml 로컬 스택용 값. 실제 값은 커밋하지 않은 .env에 설정합니다.
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_ACCESS_KEY=
LANGFUSE_MINIO_SECRET_KEY=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_PASSWORD=
