# Safe, non-secret configuration for the Agent API.
# Keep this file as a template only. Put real credentials in an untracked
# local environment or a deployment secret manager.

PORT=3000
AGENT_API_KEY=
LOG_LEVEL=info
GEO_WORKER_CONCURRENCY=4
GEO_QUEUE_MAX_WAITING=100
GEO_QUEUE_MAX_ATTEMPTS=2
GEO_QUEUE_BACKOFF_MS=5000

# Use DATABASE_URL, or configure the individual database settings below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentic_geo
DB_USERNAME=agentic_geo
DB_PASSWORD=
DB_SCHEMA=public
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=true

# Start with mock for local exploration. Configure one provider before using
# live model-backed generation.
AGENTIC_GEO_PROVIDER=mock
AGENTIC_GEO_PRODUCT_NORMALIZATION=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_REASONING_DEPLOYMENT=
AZURE_OPENAI_OCR_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_VERSION=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_PROOFREADING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_TEMPERATURE=

AGENTIC_GEO_RERANKER_PROVIDER=
AZURE_COHERE_RERANK_API_KEY=
AZURE_COHERE_RERANK_ENDPOINT=
AZURE_COHERE_RERANK_MODEL=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_INDEX_NAME=
AZURE_AI_SEARCH_SEMANTIC_CONFIGURATION=
AZURE_AI_SEARCH_QUERY_LANGUAGE=
OPENAI_VECTOR_STORE_ID=
AGENTIC_GEO_CITATION_PROBE=

# Optional Langfuse tracing. All values are intentionally blank here.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Keep the synchronous test endpoint disabled outside local test environments.
GEO_TEST_SYNC_ENDPOINT=false
