# Safe, non-secret configuration for the web consoles.
# Copy the values you need into an untracked local/deployment environment.

AGENTIC_GEO_PROVIDER=mock

# Server-only base URL used by Next.js BFF routes.
AGENTIC_GEO_API_URL=http://localhost:3000

# Required only for a static export; this value is embedded in the browser.
NEXT_PUBLIC_AGENTIC_GEO_API_URL=

# Optional managed retrieval configuration.
OPENAI_VECTOR_STORE_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_OCR_DEPLOYMENT=
AZURE_OPENAI_REASONING_DEPLOYMENT=
AZURE_OPENAI_PROOFREADING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_TEMPERATURE=

# Optional reranking/search services.
AGENTIC_GEO_RERANKER_PROVIDER=
AZURE_COHERE_RERANK_API_KEY=
AZURE_COHERE_RERANK_ENDPOINT=
AZURE_COHERE_RERANK_MODEL=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_INDEX_NAME=
AZURE_AI_SEARCH_SEMANTIC_CONFIGURATION=
AZURE_AI_SEARCH_QUERY_LANGUAGE=
