{
  "name": "@agentic-geo/pdp-geo-generator-agent",
  "author": "jungtaeinn",
  "license": "SEE LICENSE IN ../../LICENSE",
  "description": "Reusable PDP GEO generation agent that turns arbitrary product JSON into RAG-grounded schema.org JSON-LD, answer-ready PDP content, and field-contract validation diagnostics.",
  "keywords": [
    "agentic-geo",
    "pdp-geo-generator-agent",
    "sub-agent",
    "generative-engine-optimization",
    "schema-org",
    "json-ld",
    "rag",
    "pdp-content",
    "validation"
  ],
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./mock": "./src/mock.ts",
    "./rag-profile": "./src/rag/profile.ts",
    "./rest": "./src/rest.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rag:ingest-sources": "tsx scripts/ingest-sources.ts",
    "rag:precompute-embeddings": "tsx scripts/precompute-embeddings.ts",
    "rag:index-skeleton": "tsx scripts/generate-rag-index-skeleton.ts",
    "rag:generate-fallback": "tsx scripts/generate-default-profile-fallback.ts",
    "rag:eval": "tsx scripts/run-rag-eval.ts"
  },
  "dependencies": {
    "zod": "4.4.3",
    "@agentic-geo/pdp-geo-eval-agent": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
